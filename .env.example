# Server-only runtime environment. Never use NEXT_PUBLIC_ for any of these.
APP_URL=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Base64-encoded RSA PKCS8 PEM; generate with npm run setup:keys.
RSVP_PRIVATE_KEY=
RATE_LIMIT_SECRET=
CRON_SECRET=
GMAIL_ACCOUNT=
GMAIL_APP_PASSWORD=
# Keep true during local development/testing. Set false for production emails.
MAIL_DISABLED=true

# Local provisioning only; do not put the management PAT or DB password in Vercel.
SUPABASE_PROJECT_ID=
SUPABASE_PROJECT_REGION=
SUPABASE_PAT=
SUPABASE_DB_PASSWORD=
